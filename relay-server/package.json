{
  "name": "engram-voice-relay",
  "version": "1.0.0",
  "description": "Secure WebSocket relay for Engram voice conversations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "openai": "^4.76.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "form-data": "4.0.6",
    "retry-request": "8.0.3",
    "teeny-request": "10.1.3",
    "uuid": "$uuid"
  }
}
