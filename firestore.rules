rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Custom claims are optional. Guard access before dereferencing so a
    // normal authenticated user never causes a rule evaluation error.
    function isAdmin() {
      return isAuthenticated()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    // Client-permitted intent state transitions (PRD 0B). Mirrors
    // functions/src/intents/intentSchema.js isClientTransitionAllowed:
    //   any -> dismissed; suggested -> active; active -> completed_state;
    //   no-op (from == to, e.g. an authorization-only edit).
    // Structurally, `abstain` (every hard-negative) has no path to `active`.
    function intentTransitionAllowed(from, to) {
      return to == 'dismissed'
        || (from == 'suggested' && to == 'active')
        || (from == 'active' && to == 'completed_state')
        || from == to;
    }

    // Artifacts collection (main app data)
    match /artifacts/{appId}/users/{userId} {
      // Allow user to read/write their own user document
      allow read, write: if isOwner(userId);

      // Entries subcollection
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Spaces subcollection (PRD R1 Context Spaces v1 — organizational
      // containers that scope entries/retrieval via `spaceId`). Owner may
      // read/create/update but there is NO client delete: "Space deletion" in
      // v1 is archive (state: 'archived') + an optional bulk move of member
      // entries, both done via update (Task 8's client service) — journal
      // content can never be silently deleted by removing its space.
      match /spaces/{spaceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'state', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.state in ['active', 'archived'];
      }

      // Patterns subcollection
      match /patterns/{patternId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Signals subcollection (single source of truth for temporal signals)
      match /signals/{signalId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Day summaries subcollection (aggregated view for heatmap/calendar)
      // Writable by user OR by Cloud Functions (service account)
      match /day_summaries/{dateId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || isAdmin();
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Signal states subcollection (lifecycle tracking for goals, insights, patterns)
      match /signal_states/{stateId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Insight exclusions subcollection (dismissed patterns that shouldn't resurface)
      match /insight_exclusions/{exclusionId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Nexus 2.0 subcollection (insights, beliefs, interventions, baselines, states)
      match /nexus/{docId} {
        allow read: if isOwner(userId);
        // Allow write to all nexus docs EXCEPT conversation_queue (server-only)
        allow write: if isOwner(userId) && docId != 'conversation_queue';
      }

      // Insight engagement subcollection under nexus/
      match /nexus/{nexusDocId}/insight_engagement/{engagementId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Threads subcollection (life narrative threads for Nexus)
      match /threads/{threadId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Settings subcollection (user preferences)
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        // The subscription/entitlement doc is written ONLY by the server
        // (IAP / RevenueCat webhook running with admin credentials) — a client
        // must not be able to self-grant premium by writing settings/subscription.
        // The admin catch-all below still permits the trusted server write.
        //
        // settings/consent is the authoritative AI-processing consent doc. A
        // client write is only allowed when it is a well-formed consent shape:
        // aiProcessing must be a bool and no unexpected keys may be present.
        // (Server grant/revoke callables run with admin creds and bypass this.)
        //
        // settings/insightBudget (PRD R1 Insight Budget) gates how many
        // insights the Nexus surfaces show per day. `mode` must be one of the
        // three tiers; `shownLog` is an optional list field reserved for a
        // later task (per-day shown-insight ledger) and, when present, must
        // be a list.
        //
        // settings/spacePrefs (PRD R1 Context Spaces) remembers the user's
        // last explicit capture-Space selection; `lastCaptureSpaceId` is
        // either a space id (string) or null (no space remembered / unscoped).
        allow write: if isOwner(userId)
          && settingId != 'subscription'
          && (
            settingId != 'consent' || (
              request.resource.data.aiProcessing is bool
              && request.resource.data.keys().hasOnly(['aiProcessing', 'grantedAt', 'revokedAt', 'updatedAt', 'policyVersion'])
            )
          )
          && (
            settingId != 'insightBudget' || (
              request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'shownLog'])
              && request.resource.data.mode in ['quiet', 'balanced', 'exploratory']
              && (!('shownLog' in request.resource.data) || request.resource.data.shownLog is list)
            )
          )
          && (
            settingId != 'spacePrefs' || (
              request.resource.data.keys().hasOnly(['lastCaptureSpaceId', 'updatedAt'])
              && (request.resource.data.lastCaptureSpaceId is string || request.resource.data.lastCaptureSpaceId == null)
            )
          );
      }

      // Dashboard preferences subcollection
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      // Safety plan subcollection
      match /safetyPlan/{planId} {
        allow read, write: if isOwner(userId);
      }

      // RAG embeddings subcollection
      match /rag_embeddings/{embeddingId} {
        allow read, write: if isOwner(userId);
      }

      // Memory subcollection (entity graph - people, events, values, conversations)
      match /memory/{memoryDoc=**} {
        allow read, write: if isOwner(userId);
      }

      // Basic Insights subcollection (statistical correlation insights)
      match /basicInsights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      // Insight moderation reports (user flags AI output as inappropriate)
      match /insight_reports/{reportId} {
        allow read, create: if isOwner(userId);
      }

      // Insight engagement events (which insights the user explores/dismisses)
      match /insight_engagement_events/{eventId} {
        allow read, create: if isOwner(userId);
      }

      // Insight Feedback subcollection (user feedback on insight accuracy)
      match /insightFeedback/{feedbackId} {
        allow read, write: if isOwner(userId);
      }

      // Insight Learning subcollection (aggregated learning from feedback)
      match /insightLearning/{patternType} {
        allow read, write: if isOwner(userId);
      }

      // Analytics subcollection (mostly server-computed, read-only for client)
      match /analytics/{analyticsDocId} {
        allow read: if isOwner(userId);
        // gap_engagement is writable by the user for engagement tracking
        allow write: if isOwner(userId) && analyticsDocId == 'gap_engagement';

        // Gap engagement history subcollection
        match /history/{engagementId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Reports subcollection (server-generated, read-only for client)
      match /reports/{reportId} {
        allow read: if isOwner(userId);
      }

      // Report preferences subcollection (user-managed privacy settings)
      match /report_preferences/{reportId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().size() <= 10;
        allow delete: if isOwner(userId);
      }

      // Intents subcollection (PRD 0B precision-first intent system).
      // Documents are CREATED ONLY by the server (Admin SDK, via the
      // catch-all below). A client may read its own intents and make a narrow
      // set of state transitions — and only touch state/updatedAt/
      // authorization/snoozedUntil/outcome/userText (PRD R1 task-repair keys:
      // snoozing an open loop, closing it with an outcome, and editing its
      // display text). Every extraction-owned field (kind, attributes,
      // confidence, sourceSpan, versions, ...) is immutable from the client.
      // No client create or delete: model confidence alone can never mint an
      // active intent, and a user can only dismiss (never hard-delete).
      // Mirrors functions/src/intents/intentSchema.js CLIENT_MUTABLE_KEYS.
      match /intents/{intentId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['state', 'updatedAt', 'authorization', 'snoozedUntil', 'outcome', 'userText'])
          && intentTransitionAllowed(resource.data.state, request.resource.data.state);
      }

      // User decisions (append-only audit of keep/dismiss/complete actions).
      // Owner may create a shape-validated decision and read its own; never
      // update or delete (reversibility is modelled by a new decision, not a
      // mutation). Action set mirrors intentSchema.js DECISION_ACTIONS,
      // extended in PRD R1 with the task-repair/open-loop actions
      // (snoozed/answered/closed) alongside the original set.
      match /user_decisions/{decisionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.targetType == 'intent'
          && request.resource.data.keys().hasAll(['targetId', 'targetType', 'action', 'createdAt', 'reversible'])
          && request.resource.data.keys().hasOnly(['targetId', 'targetType', 'action', 'reasonCode', 'createdAt', 'reversible'])
          && request.resource.data.action in ['kept', 'dismissed', 'not_a_task', 'completed', 'snoozed', 'answered', 'closed']
          && request.resource.data.reversible == true;
      }

      // FCM tokens subcollection (write-only, no client reads or deletes)
      match /fcm_tokens/{tokenId} {
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['token', 'platform'])
          && request.resource.data.keys().size() <= 5;
      }
    }

    // Top-level runtime feature-flag doc, written only by the Admin
    // SDK/console (see functions/src/shared/flags.js, src/config/flags.js).
    // Any authenticated user may read the single `flags` doc; no other
    // config/{docId} is client-readable, and no client write is ever
    // allowed here for a normal (non-admin) user.
    //
    // Note on rule evaluation: Firestore rules are NOT "most specific match
    // wins" — every `match` block whose path pattern matches the requested
    // doc is evaluated, and the request is allowed if ANY of them grants
    // it (they OR together). So this block and the `{document=**}` admin
    // catch-all below both apply to `config/*` docs; `allow write: if
    // false` here does not shadow the catch-all, it just contributes no
    // grant of its own — the catch-all's `isAdmin()` check is what
    // actually lets Cloud Functions (using an admin-claimed token) write
    // here. The Admin SDK itself bypasses rules entirely, so this only
    // matters for admin-claimed client tokens, if any ever exist.
    match /config/{docId} {
      allow read: if isAuthenticated() && docId == 'flags';
      allow write: if false;
    }

    // Allow Cloud Functions to read/write with admin claims
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
