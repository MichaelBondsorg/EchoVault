rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Custom claims are optional. Guard access before dereferencing so a
    // normal authenticated user never causes a rule evaluation error.
    function isAdmin() {
      return isAuthenticated()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    // Client-permitted intent state transitions (PRD 0B). Mirrors
    // functions/src/intents/intentSchema.js isClientTransitionAllowed:
    //   any -> dismissed; suggested -> active; active -> completed_state;
    //   no-op (from == to, e.g. an authorization-only edit).
    // Structurally, `abstain` (every hard-negative) has no path to `active`.
    function intentTransitionAllowed(from, to) {
      return to == 'dismissed'
        || (from == 'suggested' && to == 'active')
        || (from == 'active' && to == 'completed_state')
        || from == to;
    }

    // Personal Experiments (R3, PRD "Learn Carefully") status transition
    // matrix: draft -> running -> (paused <-> running) -> stopped | completed.
    // Every no-op (from == to) is permitted so status-independent field
    // updates (excludedObservations while running, the completed-state
    // rerun-after-exclusion case below) don't also have to supply a
    // transition. stopped and completed are dead ends: there is no (stopped,
    // X) or (completed, X) pair here for X other than the same value, so no
    // further status change is ever legal once either is reached — draft ->
    // stopped and draft -> completed are deliberately absent (stop is only
    // meaningful once running/paused; a draft that shouldn't run is deleted).
    // paused -> completed is ALLOWED (execution-time product call, batch
    // review of Task 2): every v1 variable is passive (no active
    // check-in/data-collection surface), so "paused" carries no
    // data-collection meaning of its own — it is UI-state only. Forcing a
    // resume->complete two-step just to view results after endAt would be
    // pure friction with no safety or data-integrity benefit. Logged for
    // Michael's ratification alongside the other R3 decisions (PROJECT_STATUS,
    // Task 7).
    function experimentTransitionAllowed(from, to) {
      return from == to
        || (from == 'draft' && to == 'running')
        || (from == 'running' && to == 'paused')
        || (from == 'paused' && to == 'running')
        || (from == 'running' && to == 'stopped')
        || (from == 'paused' && to == 'stopped')
        || (from == 'running' && to == 'completed')
        || (from == 'paused' && to == 'completed');
    }

    // Full update-shape + freeze contract for /experiments/{id} (match block
    // below). A plain diff().affectedKeys().hasOnly([...]) can't express two
    // things this collection needs, so they're resolved here:
    //   1. startAt/endAt freeze: the plan says these ride in the CREATE
    //      hasOnly list (reserving the field names on the schema) but the
    //      create rule additionally requires their ABSENCE (see the match
    //      block below) — a draft is always created with them unset, and
    //      the service contract stamps them from durationDays at
    //      startExperiment — an UPDATE, on the draft->running transition
    //      (the "freeze moment"). Resolution: startAt/endAt are added to the
    //      update affectedKeys allow-list, but whenever either key is part of
    //      the diff, the transition MUST be draft->running. Every other
    //      update leaves them untouched, so — combined with the create-time
    //      absence guard — they are writable exactly once, ever.
    //   2. result is writable only alongside a post-state of 'completed' —
    //      this covers both the running->completed transition AND the
    //      completed->completed no-op rerun-after-exclusion case (PRD
    //      acceptance: inspect/exclude an observation and rerun on a
    //      completed experiment).
    //   3. stopped is a hard stop: once resource.data.status == 'stopped',
    //      an update may touch ONLY updatedAt. No further status change (the
    //      transition matrix already forbids that), and — unlike completed —
    //      no excludedObservations/result edits either, since PRD stop
    //      finalizes the experiment rather than leaving it open to rerun.
    function experimentUpdateAllowed(before, after) {
      let diffKeys = after.diff(before).affectedKeys();
      return diffKeys.hasOnly(['status', 'excludedObservations', 'result', 'updatedAt', 'startAt', 'endAt'])
        && experimentTransitionAllowed(before.status, after.status)
        && (!diffKeys.hasAny(['startAt', 'endAt']) || (before.status == 'draft' && after.status == 'running'))
        && (!diffKeys.hasAny(['result']) || after.status == 'completed')
        && (before.status != 'stopped' || diffKeys.hasOnly(['updatedAt']));
    }

    // Artifacts collection (main app data)
    match /artifacts/{appId}/users/{userId} {
      // Allow user to read/write their own user document
      allow read, write: if isOwner(userId);

      // Entries subcollection
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Spaces subcollection (PRD R1 Context Spaces v1 — organizational
      // containers that scope entries/retrieval via `spaceId`). Owner may
      // read/create/update but there is NO client delete: "Space deletion" in
      // v1 is archive (state: 'archived') + an optional bulk move of member
      // entries, both done via update (Task 8's client service) — journal
      // content can never be silently deleted by removing its space.
      match /spaces/{spaceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'state', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.state in ['active', 'archived'];
      }

      // Patterns subcollection
      match /patterns/{patternId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Signals subcollection (single source of truth for temporal signals)
      match /signals/{signalId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Day summaries subcollection (aggregated view for heatmap/calendar)
      // Writable by user OR by Cloud Functions (service account)
      match /day_summaries/{dateId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || isAdmin();
      }

      // Goals subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Signal states subcollection (lifecycle tracking for goals, insights, patterns)
      match /signal_states/{stateId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Insight exclusions subcollection (dismissed patterns that shouldn't resurface)
      match /insight_exclusions/{exclusionId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Nexus 2.0 subcollection (insights, beliefs, interventions, baselines, states)
      match /nexus/{docId} {
        allow read: if isOwner(userId);
        // Allow write to all nexus docs EXCEPT conversation_queue (server-only)
        allow write: if isOwner(userId) && docId != 'conversation_queue';
      }

      // Insight engagement subcollection under nexus/
      match /nexus/{nexusDocId}/insight_engagement/{engagementId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Threads subcollection (life narrative threads for Nexus)
      match /threads/{threadId} {
        allow read, write: if isOwner(userId);
      }

      // NEW: Settings subcollection (user preferences)
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        // The subscription/entitlement doc is written ONLY by the server
        // (IAP / RevenueCat webhook running with admin credentials) — a client
        // must not be able to self-grant premium by writing settings/subscription.
        // The admin catch-all below still permits the trusted server write.
        //
        // settings/consent is the authoritative AI-processing consent doc. A
        // client write is only allowed when it is a well-formed consent shape:
        // aiProcessing must be a bool and no unexpected keys may be present.
        // (Server grant/revoke callables run with admin creds and bypass this.)
        //
        // settings/insightBudget (PRD R1 Insight Budget) gates how many
        // insights the Nexus surfaces show per day. `mode`, when present, must
        // be one of the three tiers — but it is NOT required on every write:
        // `recordShownInsights` (Task 12) writes `{shownLog, updatedAt}` via a
        // merge on a doc that may not have a persisted mode yet (client
        // default is 'balanced', read separately), so a mode-less write must
        // be allowed. `request.resource.data` is the post-merge document, so
        // an already-persisted mode is still validated on every subsequent
        // write that surfaces it. `shownLog` is a list field (per-day
        // shown-insight ledger) and, when present, must be a list.
        //
        // settings/spacePrefs (PRD R1 Context Spaces) remembers the user's
        // last explicit capture-Space selection; `lastCaptureSpaceId` is
        // either a space id (string) or null (no space remembered / unscoped).
        //
        // settings/revisitPrefs (R2 Gentle Revisit) records whether the user
        // has opted in to resurfaced-content prompts; `enabled` must be a
        // bool when the doc is written.
        //
        // settings/experimentPrefs (R3 Personal Experiments) is the
        // revisitPrefs twin: records whether the user has seen the one-time
        // "associations, not proof" explainer before their first experiment
        // create flow. Experiments themselves live in their own per-doc
        // `experiments` collection below — this doc is only the explainer
        // flag, so `enabled` must be a bool when the doc is written.
        allow write: if isOwner(userId)
          && settingId != 'subscription'
          && (
            settingId != 'consent' || (
              request.resource.data.aiProcessing is bool
              && request.resource.data.keys().hasOnly(['aiProcessing', 'grantedAt', 'revokedAt', 'updatedAt', 'policyVersion'])
            )
          )
          && (
            settingId != 'insightBudget' || (
              request.resource.data.keys().hasOnly(['mode', 'updatedAt', 'shownLog'])
              && (!('mode' in request.resource.data) || request.resource.data.mode in ['quiet', 'balanced', 'exploratory'])
              && (!('shownLog' in request.resource.data) || request.resource.data.shownLog is list)
            )
          )
          && (
            settingId != 'spacePrefs' || (
              request.resource.data.keys().hasOnly(['lastCaptureSpaceId', 'updatedAt'])
              && (request.resource.data.lastCaptureSpaceId is string || request.resource.data.lastCaptureSpaceId == null)
            )
          )
          && (
            settingId != 'revisitPrefs' || (
              request.resource.data.keys().hasOnly(['enabled', 'optInAt', 'updatedAt'])
              && request.resource.data.enabled is bool
            )
          )
          && (
            settingId != 'experimentPrefs' || (
              request.resource.data.keys().hasOnly(['enabled', 'optInAt', 'updatedAt'])
              && request.resource.data.enabled is bool
            )
          );
      }

      // Dashboard preferences subcollection
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      // Safety plan subcollection
      match /safetyPlan/{planId} {
        allow read, write: if isOwner(userId);
      }

      // RAG embeddings subcollection
      match /rag_embeddings/{embeddingId} {
        allow read, write: if isOwner(userId);
      }

      // Memory subcollection (entity graph - people, events, values, conversations)
      match /memory/{memoryDoc=**} {
        allow read, write: if isOwner(userId);
      }

      // Basic Insights subcollection (statistical correlation insights)
      match /basicInsights/{insightId} {
        allow read, write: if isOwner(userId);
      }

      // Insight moderation reports (user flags AI output as inappropriate)
      match /insight_reports/{reportId} {
        allow read, create: if isOwner(userId);
      }

      // Insight engagement events (which insights the user explores/dismisses)
      match /insight_engagement_events/{eventId} {
        allow read, create: if isOwner(userId);
      }

      // Insight Feedback subcollection (user feedback on insight accuracy)
      match /insightFeedback/{feedbackId} {
        allow read, write: if isOwner(userId);
      }

      // Insight Learning subcollection (aggregated learning from feedback)
      match /insightLearning/{patternType} {
        allow read, write: if isOwner(userId);
      }

      // Analytics subcollection (mostly server-computed, read-only for client)
      match /analytics/{analyticsDocId} {
        allow read: if isOwner(userId);
        // gap_engagement is writable by the user for engagement tracking
        allow write: if isOwner(userId) && analyticsDocId == 'gap_engagement';

        // Gap engagement history subcollection
        match /history/{engagementId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Reports subcollection (server-generated, read-only for client)
      match /reports/{reportId} {
        allow read: if isOwner(userId);
      }

      // Report preferences subcollection (user-managed privacy settings)
      match /report_preferences/{reportId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().size() <= 10;
        allow delete: if isOwner(userId);
      }

      // Intents subcollection (PRD 0B precision-first intent system).
      // Documents are CREATED ONLY by the server (Admin SDK, via the
      // catch-all below). A client may read its own intents and make a narrow
      // set of state transitions — and only touch state/updatedAt/
      // authorization/snoozedUntil/outcome/userText (PRD R1 task-repair keys:
      // snoozing an open loop, closing it with an outcome, and editing its
      // display text). Every extraction-owned field (kind, attributes,
      // confidence, sourceSpan, versions, ...) is immutable from the client.
      // No client create or delete: model confidence alone can never mint an
      // active intent, and a user can only dismiss (never hard-delete).
      // Mirrors functions/src/intents/intentSchema.js CLIENT_MUTABLE_KEYS.
      match /intents/{intentId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['state', 'updatedAt', 'authorization', 'snoozedUntil', 'outcome', 'userText'])
          && intentTransitionAllowed(resource.data.state, request.resource.data.state);
      }

      // User decisions (append-only audit of keep/dismiss/complete actions).
      // Owner may create a shape-validated decision and read its own; never
      // update or delete (reversibility is modelled by a new decision, not a
      // mutation). Action set mirrors intentSchema.js DECISION_ACTIONS,
      // extended in PRD R1 with the task-repair/open-loop actions
      // (snoozed/answered/closed) alongside the original set.
      match /user_decisions/{decisionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.targetType == 'intent'
          && request.resource.data.keys().hasAll(['targetId', 'targetType', 'action', 'createdAt', 'reversible'])
          && request.resource.data.keys().hasOnly(['targetId', 'targetType', 'action', 'reasonCode', 'createdAt', 'reversible'])
          && request.resource.data.action in ['kept', 'dismissed', 'not_a_task', 'completed', 'snoozed', 'answered', 'closed']
          && request.resource.data.reversible == true;
      }

      // FCM tokens subcollection (write-only, no client reads or deletes)
      match /fcm_tokens/{tokenId} {
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasAll(['token', 'platform'])
          && request.resource.data.keys().size() <= 5;
      }

      // NEW (R2): Source exclusions (user excludes an entry/pattern-type from
      // a given surface, permanently). Owner may read/create/delete — there
      // is NO update: deleting the exclusion doc IS the "restore" action, a
      // client can never edit an exclusion in place.
      match /source_exclusions/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['entryId', 'appliesTo', 'reason', 'permanent', 'createdAt'])
          && request.resource.data.entryId is string
          && request.resource.data.appliesTo is string
          && request.resource.data.reason in ['wrong_source', 'excluded_by_user']
          && request.resource.data.permanent == true;
        allow delete: if isOwner(userId);
      }

      // NEW (R2): Reflection Recipes (user-defined, reusable question sets
      // that drive recipe_run reflections). Owner has full CRUD, shape-
      // validated on create/update.
      match /recipes/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'questions', 'scope', 'timeRangeDays', 'cadence', 'state', 'definitionVersion', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.questions is list && request.resource.data.questions.size() <= 5
          && request.resource.data.state in ['active', 'archived']
          && request.resource.data.cadence in ['manual'];
      }

      // NEW (R2): Reflections (generated output — either a recipe_run against
      // a Recipe above, or a session_brief). Owner has full CRUD, shape-
      // validated on create/update.
      match /reflections/{id} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['kind', 'recipeId', 'definitionVersion', 'scope', 'period', 'title', 'blocks', 'status', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['recipe_run', 'session_brief']
          && request.resource.data.title is string
          && request.resource.data.blocks is list
          && request.resource.data.status in ['draft', 'final'];
      }

      // NEW (R2): Gentle Revisit exclusions (user opts a dimension — entry,
      // date, person, tag, space, or an entire family of resurfaced content —
      // out of future revisit surfacing). Owner may read/create/delete — NO
      // update: delete = restore, same pattern as source_exclusions above.
      match /revisit_exclusions/{id} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['dimension', 'value', 'reason', 'permanent', 'createdAt', 'expiresAt'])
          && request.resource.data.dimension in ['entry', 'date', 'person', 'tag', 'space', 'family']
          && request.resource.data.value is string
          && request.resource.data.reason in ['never_show', 'less_like_this', 'hidden_dim'];
        allow delete: if isOwner(userId);
      }

      // NEW (R2): Gentle Revisit queue (server-computed candidates for
      // resurfacing). NO client create — only the server (Admin SDK, via the
      // catch-all below) may enqueue candidates. Owner may read/delete their
      // own queue entries, and may update ONLY the status (marking an item
      // shown/dismissed) plus updatedAt — every other field is immutable
      // from the client.
      match /revisit_queue/{id} {
        allow read, delete: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['shown', 'dismissed'];
      }

      // NEW (R3): Personal Experiments (PRD "Learn Carefully" — flag
      // `personalExperiments`, stays OFF until Michael signs off
      // docs/quality/experiments-data-method.md). Owner has full CRUD.
      // Create is shape- and draft-only validated (no `result` may be
      // written at create time — an experiment cannot be born with a
      // result; same absence guard applies to `startAt`/`endAt` — they ride
      // in the hasOnly list so the field names are reserved on the schema,
      // but a client cannot seed a non-null value at create time, only the
      // draft->running stamp in experimentUpdateAllowed can ever write them,
      // which is what makes "writable exactly once, at the freeze moment"
      // true). Update is governed entirely by experimentUpdateAllowed
      // above: question/template/analysisPlan/scope/createdAt are NOT in
      // its affectedKeys allow-list at all, so they are immutable for the
      // life of the document once created — the PRD plan-freeze invariant.
      // There is no client path to edit them post-create, running or not.
      match /experiments/{experimentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['question', 'template', 'analysisPlan', 'scope', 'status', 'startAt', 'endAt', 'durationDays', 'excludedObservations', 'result', 'createdAt', 'updatedAt'])
          && request.resource.data.question is string && request.resource.data.question.size() <= 200
          && request.resource.data.template is string
          && request.resource.data.analysisPlan is map
          && request.resource.data.status == 'draft'
          && request.resource.data.durationDays in [14, 28]
          && request.resource.data.excludedObservations is list
          && !request.resource.data.keys().hasAny(['result'])
          && !request.resource.data.keys().hasAny(['startAt', 'endAt']);
        allow update: if isOwner(userId) && experimentUpdateAllowed(resource.data, request.resource.data);
      }

      // R4 Phase 1: hypothesis-family testing ledger. Append-only in spirit:
      // testedCount may never decrease (the multiple-testing count must be
      // durable even when candidates are inconclusive or later suppressed).
      match /testing_ledger/{ledgerId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['familyId', 'candidates', 'testedCount', 'createdAt', 'updatedAt'])
          && request.resource.data.testedCount is int
          && request.resource.data.testedCount >= 0;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['candidates', 'testedCount', 'updatedAt'])
          && request.resource.data.testedCount is int
          && request.resource.data.testedCount >= resource.data.testedCount;
      }

      // R4 Phase 1: canonical InsightClaim store. Claims are immutable facts —
      // after create, only supersede-pointer, status, and updatedAt may change.
      // Corrections create a NEW claim version; history is never rewritten.
      match /insight_claims/{claimId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'version', 'parentClaimId', 'supersededByClaimId', 'claimType', 'subject', 'outcome', 'direction', 'questionWording', 'wording', 'limitations', 'analysisPlan', 'evidence', 'receipt', 'status', 'provenance', 'createdAt', 'updatedAt'])
          && request.resource.data.status in ['candidate', 'verified', 'suppressed', 'expired']
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && ((request.resource.data.version == 1 && request.resource.data.parentClaimId == null)
              || (request.resource.data.version > 1 && request.resource.data.parentClaimId is string));
        // Update is a narrow set of pointer/state stamps, never the fact
        // itself: status may only move FORWARD through the lifecycle (never
        // back to 'candidate' — a corrected claim is a new version, not a
        // reopened one), and supersededByClaimId, when present, is either
        // null (not yet superseded) or the id (string) of the claim that
        // replaced it.
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'supersededByClaimId', 'updatedAt'])
          && request.resource.data.status in ['verified', 'suppressed', 'expired']
          && (!('supersededByClaimId' in request.resource.data)
              || request.resource.data.supersededByClaimId == null
              || request.resource.data.supersededByClaimId is string);
      }
    }

    // Top-level runtime feature-flag doc, written only by the Admin
    // SDK/console (see functions/src/shared/flags.js, src/config/flags.js).
    // Any authenticated user may read the single `flags` doc; no other
    // config/{docId} is client-readable, and no client write is ever
    // allowed here for a normal (non-admin) user.
    //
    // Note on rule evaluation: Firestore rules are NOT "most specific match
    // wins" — every `match` block whose path pattern matches the requested
    // doc is evaluated, and the request is allowed if ANY of them grants
    // it (they OR together). So this block and the `{document=**}` admin
    // catch-all below both apply to `config/*` docs; `allow write: if
    // false` here does not shadow the catch-all, it just contributes no
    // grant of its own — the catch-all's `isAdmin()` check is what
    // actually lets Cloud Functions (using an admin-claimed token) write
    // here. The Admin SDK itself bypasses rules entirely, so this only
    // matters for admin-claimed client tokens, if any ever exist.
    match /config/{docId} {
      allow read: if isAuthenticated() && docId == 'flags';
      allow write: if false;
    }

    // Allow Cloud Functions to read/write with admin claims
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
