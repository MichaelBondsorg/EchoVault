{
  "name": "engram",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-endpoints.js && node scripts/check-bundle-budget.js",
    "preview": "vite preview",
    "generate:icons": "node scripts/generate-icons.js",
    "generate:splash": "node scripts/generate-splash.js",
    "generate:assets": "npm run generate:icons && npm run generate:splash",
    "generate:feature-manifest": "node scripts/generate-feature-manifest.js",
    "check:feature-manifest": "node scripts/generate-feature-manifest.js --check",
    "model:manifest": "node scripts/generate-model-manifest.mjs",
    "model:manifest:check": "node scripts/generate-model-manifest.mjs --check",
    "model:benchmark": "node scripts/benchmark-model.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:build:ios": "npm run build && cap sync ios && cap build ios",
    "cap:build:android": "npm run build && cap sync android && cap build android",
    "test": "vitest run",
    "test:ci-parity": "rm -rf node_modules/.vite && CI_PARITY=1 vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project echo-vault-test \"vitest run --config vitest.rules.config.js\"",
    "test:ci": "npm test && npm run test:rules && npm run build",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "@capacitor-firebase/crashlytics": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.2.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@echovault/capacitor-health-extended": "file:./plugins/capacitor-health-extended",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/newsreader": "^5.2.10",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@xyflow/react": "^12.10.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^12.23.26",
    "jspdf": "2.5.1",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "firebase-tools": "^15.24.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^5.0.10",
    "vitest": "^3.0.0"
  }
}
