<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Engram</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.echovault.engram</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>engram</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.googleusercontent.apps.581319345416-oijg7nb3nus8fni8q5ia31u8slkfrmrs</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.581319345416-oijg7nb3nus8fni8q5ia31u8slkfrmrs</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAudio</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Record Entry</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.echovault.engram.record</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeCompose</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Write Entry</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.echovault.engram.write</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- SEC-01: NSAllowsArbitraryLoads / NSAllowsArbitraryLoadsInWebContent
	     removed. Every host this app talks to (Firebase, Google identity/
	     functions, Open-Meteo, sunrise-sunset.org, the Cloud Run voice
	     relay) is HTTPS/WSS, so the ATS default (TLS 1.2+, no exceptions)
	     applies with zero per-domain carve-outs needed. NSAllowsLocalNetworking
	     is kept — it only permits requests to literal local/link-local
	     addresses (still under standard ATS TLS rules) and Capacitor's
	     capacitor.config.ts does not enable a cleartext dev server
	     (`server.cleartext`/`server.url` are both commented out), so there
	     is no cleartext dev-server exception to scope here either. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to securely access your private journal entries.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Engram reads your health data (sleep, steps, heart rate) on this device to show how it relates to your mood. With your AI-analysis consent, health summaries may be included in cloud analysis and your own reports. It is never sold or shared with third parties for their purposes.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Engram does not write any data to Apple Health.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Engram needs microphone access to record voice journal entries. Your recordings are transcribed and stored securely.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Engram uses speech recognition to transcribe your voice journal entries into text.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>Engram does not track you. We only collect data necessary to provide journaling features.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
